# Copy this file to .env at the repository root and fill in your own values:
#
#   cp .env.example .env
#
# .env is git-ignored, so the real keys never reach the repository. ocular/config.py
# loads it on import, and docker-compose.yml passes it to the app container.

# --- Required for the assistant -------------------------------------------------
# Gemini API key for answering, question generation and the LLM judge.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Needed for the evaluation -----------------------------------------------------
# OpenAI API key. A different model family from Gemini writes the evaluation
# questions and judges the answers, so the model being evaluated never grades or
# sets its own test. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Needed for the assistant's search and some embedding models ------------------
# Hugging Face access token. The assistant searches a collection embedded with
# EmbeddingGemma (google/embeddinggemma-300m), a gated model: accept its licence on its Hugging Face page, then create a read token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Optional: building the corpus ------------------------------------------------
# NCBI asks callers to identify themselves. With an API key the request cap rises
# from 3 to 10 per second, which speeds up scripts/build_corpus.py.
# Create one under Account settings at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=

# --- Optional: running without Docker ---------------------------------------------
# docker-compose.yml sets these for the app container. Set them here only to point a
# local run (uv run uvicorn app.api:app) at the Docker services.
#
# Search Qdrant instead of the in-memory index in data/index.
# QDRANT_URL=http://localhost:6333
# Which collection to search. Defaults to the evaluated 508-article index.
# QDRANT_COLLECTION=section__embeddinggemma-300m__corpus_full
# Send traces of every scan analysis and question to MLflow.
# MLFLOW_TRACKING_URI=http://localhost:5001
