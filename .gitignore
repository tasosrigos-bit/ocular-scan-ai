# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Datasets and caches: 12 GB of raw images and .npy caches, all regenerated by the
# notebooks and scripts. The contents are excluded rather than the directory itself,
# because git cannot re-include a file whose parent directory is excluded.
data/*

# The exceptions, all small and all inputs rather than regenerable artifacts, so that
# a fresh clone can run as much as possible without the 12 GB of raw imagery. Each
# level has to be re-included in turn, because git cannot descend into an excluded
# directory to reach a file inside it.
!data/split.csv

!data/raw/
data/raw/*
# The 37 de-identified clinic B-scans, 11 MB. The reports they came from stay out
# permanently, see the Reports rule below.
!data/raw/bscans/
# The OCTDL label file, 53 KB, which maps its vocabulary onto the four classes.
!data/raw/octdl_dl/
data/raw/octdl_dl/*
!data/raw/octdl_dl/OCTDL_labels.csv

# The corpus manifest, 99 KB, read by notebook 05. The corpus itself is rebuilt.
!data/corpus/
data/corpus/*
!data/corpus/metadata.csv

# Model weights: each ConvNeXt checkpoint is ~110 MB, over GitHub's 100 MB
# per-file limit. The notebooks reproduce every reported number from the CSVs.
*.pt

# Real clinic reports: PDFs carrying patient name, ID and date of birth.
# Never commit them. The de-identified B-scans live under data/raw/bscans.
Reports/
*.pdf

# Secrets: HF token, LLM API keys. Never commit.
.env

# Claude Code local config and scratch.
.claude/
